# Copy to .env.local for local development. Never commit real values.
# All variables are public (NEXT_PUBLIC_*) because the site is a static export:
# they are inlined into the HTML/JS at build time. Do NOT put secrets here.

# Canonical origin used for canonical URLs, sitemap, Open Graph and schema.
NEXT_PUBLIC_SITE_URL=https://tools.calculatewellhub.in

# Set to "true" ONLY on the production build. Any other value adds
# <meta name="robots" content="noindex"> to every page and a Disallow-all robots.txt,
# so staging/preview deployments are never indexed.
NEXT_PUBLIC_ALLOW_INDEXING=false

# Google AdSense publisher ID, e.g. ca-pub-0000000000000000. Leave empty to disable ads.
NEXT_PUBLIC_ADSENSE_CLIENT=
# Show dashed ad placeholders during development so you can review ad placement.
NEXT_PUBLIC_SHOW_AD_PLACEHOLDERS=false

# Newsletter: URL of your email provider's hosted form endpoint (POST).
# Examples: a Mailchimp / ConvertKit / Buttondown / Brevo form action URL.
# Leave empty and the signup box shows a "coming soon" note instead of a fake form.
NEXT_PUBLIC_NEWSLETTER_ACTION=

# Contact form: a form backend endpoint (e.g. Formspree, Basin, Getform).
# Leave empty and the contact page falls back to a mailto: link.
NEXT_PUBLIC_CONTACT_FORM_ENDPOINT=

# Optional: Google Search Console verification token (content of the meta tag).
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
